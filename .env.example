# Role IDs that give members a lower coinflip win chance (stacks if both apply).
COINFLIP_UNLUCKY_ROLE_ID=""       # -5%
COINFLIP_UNLUCKY_ROLE_ID_2=""     # -10%
# Channel ID where economy commands are blocked.
MAIN_CHAT_CHANNEL_ID=""
# CockroachDB (or any Postgres-compatible) connection string used for the economy system.
# e.g. postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
# Prefer secrets/database_url (see docker-compose.yml) over this — this is only a fallback
# for local `npm run dev`, same as TOKEN is for secrets/discord_token.
DATABASE_URL=""
