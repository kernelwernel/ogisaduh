CLIENT_ID=""
GUILD_ID=""
BOT_ACTIVITY="prefix: $"
PREFIX="$"
OGISADA_ID=""
OWNER_ID=""
OPENROUTER_API_KEY=""
# Prefer secrets/deepseek_api_key (see docker-compose.yml) over this — this is only a fallback
# for local `npm run dev`, same as TOKEN is for secrets/discord_token.
